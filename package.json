{
  "name": "gather-desktop",
  "version": "0.4.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "A quieter place for your people. Private group chat and voice for desktop.",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "dist": "npm run build && electron-builder --win nsis portable --x64 --publish never && node scripts/sign-updates.mjs",
    "dist:native": "npm run build && electron-builder --publish never",
    "cloud:login": "wrangler login",
    "cloud:dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "cloud:deploy": "npm run build && node scripts/prepare-download.mjs && wrangler deploy",
    "cloud:secrets": "node scripts/deploy-secrets.mjs",
    "release:publish": "npm run dist && npm run test:release && node scripts/prepare-download.mjs && wrangler deploy",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "electron-updater": "6.8.11",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2",
    "npm": "12.2.1",
    "prettier": "3.9.10",
    "rcedit": "5.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "build": {
    "appId": "com.gather.desktop",
    "afterPack": "scripts/embed-windows-icon.cjs",
    "productName": "Gather",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/downloads/**",
      "!dist/updates/**",
      "!dist/**/*.map",
      "electron/**",
      "server/**",
      "licenses/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.ico",
      "artifactName": "Gather-${version}-Windows.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "Gather-${version}-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icon.icns",
      "artifactName": "Gather-${version}-macOS-${arch}.${ext}",
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Gather uses your microphone when you join a voice call."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icon.png",
      "artifactName": "Gather-${version}-Linux-${arch}.${ext}",
      "executableName": "gather",
      "category": "Network",
      "maintainer": "Gather maintainers",
      "desktop": {
        "entry": {
          "StartupWMClass": "Gather"
        }
      }
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://gather-friends.max-jacob-hastings.workers.dev/updates/",
        "useMultipleRangeRequest": false
      }
    ]
  }
}
