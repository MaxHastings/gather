{
  "name": "gather-friends",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gather-private-media" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/realtime",
      "/join/*",
      "/download/*",
      "/updates/*",
    ],
  },
  "durable_objects": {
    "bindings": [{ "name": "GATHER", "class_name": "GatherRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GatherRoom"] }],
  "observability": { "enabled": false },
}
