# Run `npm run server` on one shared host. Node 24+ is required.
HOST=127.0.0.1
PORT=4318
DATA_DIR=./data
# For friends over the internet, put this server behind HTTPS and set HOST=0.0.0.0.
# PUBLIC_URL=https://gather.yourdomain.com
# ALLOWED_ORIGINS=https://gather.yourdomain.com

# Voice relay. These belong only on the server, never in VITE_ variables.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
# Or use any standard coturn server with time-limited REST credentials:
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SHARED_SECRET=

# Operator-only backup access and local encryption. Never put these in clients.
# Generate both with: node scripts/configure-operations.mjs
GATHER_ADMIN_TOKEN=
GATHER_BACKUP_KEY=
# Release signing only; never deploy to the server or include in the app.
# Initialize locally with: node scripts/init-update-key.mjs
GATHER_UPDATE_SIGNING_KEY=

# GIF search (Klipy). Server-side only; the app never sees this key.
# KLIPY_API_KEY=
